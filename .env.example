# Supabase Project Settings > API. Use the legacy anon/public JWT key, NOT service_role.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-LEGACY-ANON-KEY

# Server-only: required for private contact / offer submissions. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Node.js CMS on Vercel, without Supabase:
# CMS_BACKEND=json
# UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# CMS_ADMIN_USERNAME=
# CMS_ADMIN_PASSWORD_HASH=
# CMS_STORAGE_PREFIX=yellostack:cms:production
