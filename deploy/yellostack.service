[Unit]
Description=YelloStack website and CMS
After=network.target

[Service]
Type=simple
User=yellostack
Group=yellostack
WorkingDirectory=/srv/yellostack/current
Environment=NODE_ENV=production
Environment=CMS_BACKEND=local
Environment=CMS_DATA_DIR=/var/lib/yellostack
Environment=SITE_ALLOWED_ORIGINS=https://yellostack.com,https://www.yellostack.com,https://preview.yellostack.com
EnvironmentFile=/etc/yellostack/environment
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yellostack /srv/yellostack/current/.next

[Install]
WantedBy=multi-user.target
